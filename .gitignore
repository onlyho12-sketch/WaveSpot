# 의존성 · 빌드
node_modules/
frontend/dist/
frontend/dist-*/
backend/.venv/
__pycache__/
*.pyc

# 실행 데이터
db/*.db
db/*.db-*
db/checkpoint.json
db/auth.key

# 모델 파일은 설치 단계에서 학습해 만듦 (저장소에는 학습 코드만)
backend/app/ml/artifacts/

# 웹 시연판 빌드 산출물 (server/web/build.ps1 로 다시 만듦)
frontend/public/py/
server/web/.venv-web/
server/web/artifacts-web/
.vercel/

# 환경 · 편집기
.env
backend/.env
.vscode/
.idea/
*.log

# 코드만 올림: 디자인 참고 캡처 · 화면 캡처 · 압축 파일 · 문서 파일 · 이전 UI 는 로컬 전용
docs/UI_레퍼런스/
docs/화면_캡처_*/
docs/*.zip
frontend/_이전UI_*/
*.docx
*.pdf

# 수신기 펌웨어: 비밀번호가 들어가는 설정 · 빌드 산출물
firmware/**/config.h
firmware/.pio/

# 타입 검사 캐시
*.tsbuildinfo
